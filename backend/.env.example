# Copy to .env and fill in. .env is git-ignored — never commit secrets.
# These three describe the DEFAULT LLM gateway (OpenCode Go). The other
# gateways — OpenCode Zen, OpenRouter, Google Gemini, Command Code — are
# configured from the admin panel and stored in the settings DB, so switching
# provider needs no .env edit and no restart. See docs/llm-gateways.md.
OPENCODE_GO_API_KEY=sk-your-opencode-go-key
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_MODEL=deepseek-v4-flash

# REQUIRED. Owner token: gates the admin panel and every mutating endpoint.
# The app REFUSES TO START if this is empty while MUTATION_AUTH is on (the
# default) — a deploy that forgets it dies loudly instead of 403-ing silently.
ADMIN_TOKEN=change-me

# Exact origin of the frontend, for CORS.
# FRONTEND_ORIGIN=http://localhost:3023

# GITHUB_TOKEN=ghp_xxx   # optional: raises GitHub API rate limits from 60 to 5000 req/hr

# --- Security posture (safe defaults; you normally don't set these) ---
# MUTATION_AUTH=1        # DEFAULT ON. Requires the admin token on status-flip /
#                        # seed / verify-run endpoints. Set 0 only for a
#                        # throwaway local instance you don't mind anyone writing to.
# RATE_LIMIT_ENABLED=1   # DEFAULT ON. Per-IP rate limits on the admin gate + mutations.
# FORWARDED_ALLOW_IPS=   # Reverse-proxy address, so uvicorn resolves the real
#                        # client IP for rate limiting. Empty = trust nothing.
#                        # NEVER "*" on a public host: any caller could then spoof
#                        # X-Forwarded-For and bypass the per-IP limits.

# --- Operational ---
# LOG_LEVEL=INFO             # DEBUG|INFO|WARNING|ERROR — logs go to stdout
# DB_PATH=                   # defaults to backend/data/ideasexist.db (/data/... in Docker)
# VERIFY_AUTO_STALE_DAYS=7   # scheduled verification threshold; 0 disables

# --- Teardown (Phase 2) ---
# FOUNDER_DB_PATH=           # the founder's own store, its own file. Never the archive:
#                            # hosting must exclude this file from backups and the privacy
#                            # copy differs per case (docs/teardown-spec.md §3.1).
# CAPTURE_STALE_DAYS=7       # just-in-time teardown freshness window (same clock as VERIFY)
# REVIEW_SOURCES=[]          # JSON list of {name, kind, url_template}; kind is reddit_json|rss.
#                            # Providers are CONFIG so adding a platform is not a phase.
#                            # A walled provider (403/429) is a skip, never a strike.

# --- LLM gateways (admin panel) ---
# SETTINGS_DB_PATH=          # which gateway is active + its key/model/base-URL overrides.
#                            # Its OWN file, like the founder store, and for a stronger reason:
#                            # it holds API KEYS. The archive file is copied, backed up and
#                            # shared (the phase verifiers copy it routinely), so a secret must
#                            # never live in it. Hosting must exclude this file from backups too.
#
# Optional: a key here is picked up as the fallback for its gateway, so a
# single-provider install can stay entirely in .env (no panel visit needed).
# OPENCODE_ZEN_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=            # or GOOGLE_API_KEY
# COMMAND_CODE_API_KEY=

