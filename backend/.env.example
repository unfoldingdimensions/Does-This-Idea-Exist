# Copy to .env and fill in. .env is git-ignored — never commit secrets.
OPENCODE_GO_API_KEY=sk-your-opencode-go-key
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_MODEL=deepseek-v4-flash
# Admin seeder gate — "knows it's me". Empty = admin panel disabled.
# Same env var on your host when deployed (local and hosted behave identically).
ADMIN_TOKEN=change-me
# GITHUB_TOKEN=ghp_xxx   # optional: raises GitHub API rate limits from 60 to 5000 req/hr
# FRONTEND_ORIGIN=http://localhost:3023
