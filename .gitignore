# deps
node_modules/
.next/
out/

# python
backend/.venv/
__pycache__/
*.pyc

# secrets & local data
.env
backend/.env
frontend/.env.local
backend/data/*
!backend/data/seed_famous.json
!backend/data/seed_design_library.json

# misc
.DS_Store

# QA output — ad-hoc runs stay local. The reviewed reports and the screenshots
# they cite are project history (referenced from PRODUCT.md) and stay tracked;
# the blanket `dogfood-output/` rule used to contradict those 6 committed files.
# Allow-listed explicitly, same pattern as backend/data above, so a stray new
# screenshot doesn't get swept in by `git add -A`.
.dogfood-output/
dogfood-output/*
!dogfood-output/*.md
!dogfood-output/screenshots/
dogfood-output/screenshots/*
!dogfood-output/screenshots/dup-zoom-search.png
!dogfood-output/screenshots/home-dark.png
!dogfood-output/screenshots/home-initial.png
!dogfood-output/screenshots/search-obsidian-relevance.png

# lighthouse QA artifacts
scripts/lh-*.json
